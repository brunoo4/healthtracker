{
  "$schema": "https://www.schemastore.org/tsconfig",
  "_version": "24.0.0",

  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "module": "nodenext",
    "moduleResolution": "node16",
    "target": "es2024",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  // Sem isto o TS varre **/* a partir de api/ e puxa prisma.config.ts, que
  // vive fora do rootDir. Esse arquivo é carregado pelo Prisma CLI, não pelo
  // build da API.
  "include": ["src/**/*"]
}
