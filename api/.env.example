# ─────────────────────────────────────────────
# api/.env.example
# Copie para api/.env e preencha os valores.
# A API NÃO deve ter credenciais do Garmin.
# ─────────────────────────────────────────────

# Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Banco de dados
# Formato: postgresql://usuario:senha@host:porta/banco?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/garmin_dashboard?schema=public

# Logs
# Valores: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# CORS — origem do frontend em desenvolvimento
CORS_ORIGIN=http://localhost:5173