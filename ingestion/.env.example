# ─────────────────────────────────────────────
# ingestion/.env.example
# Copie para ingestion/.env e preencha os valores.
# Único componente com acesso às credenciais do Garmin.
# ─────────────────────────────────────────────

# Credenciais do Garmin Connect
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Caminho do arquivo de sessão (evita reautenticar a cada execução)
GARMIN_SESSION_PATH=.garmin_session

# Banco de dados — mesma instância usada pela API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/garmin_dashboard

# Janela padrão de ingestão quando nenhum período é informado (em dias)
SYNC_DEFAULT_DAYS=7

# Pausa entre requisições ao Garmin, em segundos (evita rate limit / 429)
REQUEST_DELAY_SECONDS=2

# Logs
LOG_LEVEL=INFO

OUTPUT_DIR=output