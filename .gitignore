prisma/*.db
prisma/*.db-journal
/api/generated/prisma

# ─── Agentes / skills locais ─────────────────────────
# Symlinks gerados pelo Prisma CLI, resolvidos por máquina
**/.claude/skills/

# ─── Dados locais ────────────────────────────────────
*.sqlite
*.sqlite3
/data/
*.dump

# Saídas antigas do script (JSON bruto) — não versionar dados pessoais
ingestion/output/
*.json.bak

# ─── Editor / SO ─────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# ─── Testes e cobertura ──────────────────────────────
coverage/
.nyc_output/

# ─── Logs ────────────────────────────────────────────
logs/
*.log