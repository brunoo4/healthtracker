# ─── Segredos ────────────────────────────────────────
.env
.env.*
!.env.example

# Sessão/token do Garmin
.garmin_session
.garth/
*.session

# ─── Node / TypeScript ───────────────────────────────
node_modules/
dist/
build/
*.tsbuildinfo
.npm/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Prisma ──────────────────────────────────────────
